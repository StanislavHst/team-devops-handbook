#!/usr/bin/env bash
# pre-commit: lint ONLY the files that are staged for this commit.
#   *.sh -> shellcheck      *.py -> ruff (rules E,F,W)
# Any finding aborts the commit (non-zero exit).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0
checked=0

# Added/Copied/Modified files only (deleted files cannot be linted).
while IFS= read -r -d '' file; do
    case "$file" in
        *.sh)
            command -v shellcheck >/dev/null 2>&1 || { echo "pre-commit: shellcheck is not installed (pip install shellcheck-py)" >&2; exit 2; }
            echo "shellcheck: $file"
            # Lint the STAGED version (from the index), not the working-tree copy.
            git show ":$file" | shellcheck --shell=bash - || fail=1
            checked=$((checked + 1))
            ;;
        *.py)
            command -v ruff >/dev/null 2>&1 || { echo "pre-commit: ruff is not installed (pip install ruff)" >&2; exit 2; }
            echo "ruff: $file"
            git show ":$file" | ruff check --select E,F,W --line-length 120 --stdin-filename "$file" - || fail=1
            checked=$((checked + 1))
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [[ "$fail" -ne 0 ]]; then
    echo "pre-commit: lint errors found - commit aborted." >&2
    exit 1
fi
echo "pre-commit: OK ($checked file(s) checked)"
